extern fun printf(str:u8*, ...) void;


fun get_length(arr: void**) i32 {
    return *@i32*(arr);
}

fun increment_length(arr: void**, bytes: i32) i32 {
    *@i32*(arr) += bytes;
}

fun push_int(arr: void**, val: i32) void {
   length: i32 = get_length(arr) + 4; 
   *@i32*(arr + length) = val;
   increment_length(arr, 4);
}
fun push_float(arr: void**, val: f32) void {
   length: i32 = get_length(arr) + 4; 
   *@f32*(arr + length) = val;
   increment_length(arr, 4);
}
fun get_int(arr: void**, i: i32) i32 {
    return *@i32*(arr + 4 + i * 4);
}
fun get_float(arr: void**, i: i32) f32 {
    return *@f32*(arr + 4 + i * 4);
}

fun main() i32 
{
    my_arr: void*[16];
    *@i32*(my_arr) = 0;
    
    for (i: i16 = 0; i < 16; i += 1) {
        if i % 2 push_int(my_arr, i);
        else push_float(my_arr, @f32(i));
    }
    for (i: i16 = 0; i < 16; i += 1) {
        if i % 2 
        {
            value: i32 = get_int(my_arr, i);
            printf("arr[%d] = %d\n\0", i, value); 
        }
        else 
        {
            value: f32 = get_float(my_arr, i);
            printf("arr[%d] = %f\n\0", i, value); 
        }
    }

    printf("length = %d\n\0", get_length(my_arr)); 
    

    return 0;
}


