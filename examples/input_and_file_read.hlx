extern fun printf(str: u8*,...) void;
extern fun malloc(c: u32) void*;
extern fun fopen(path: u8*, mode: u8*) u32*;
extern fun fgets(buf: u8*, a: u32, b: u32*) u32*;
extern fun fclose(f: u32*) void;
extern fun srand(seed: u32) void;
extern fun rand() i64;
extern fun time(n: u32*) u64;
extern fun scanf(format: u8*, ...) void;

fun main(argc: i64, argv: u8**) i32
{

    fptr: u32* = fopen("examples/input_and_file_read.hlx\0", "r\0");
    if (!fptr) {
        printf("Run this program in the root!\n\0");
        return 0;
    }

    srand(time(0));
    input: i32 = 0;
    printf("If you guess the number right from 1 to 3,\nI will print this file!\n\0");
    random: i32 = 1;
    while input != random
    {
        random = rand() % 3 + 1;
        scanf("%d\0", &input);
        printf("entered: %d\n\0", input);
        printf("random: %d\n\0", random);
  
    }
    buf: u8* =  malloc(8);
    while fgets(buf, 8, fptr) != 0
    {
        printf("%s\0", buf);
    }
    fclose(fptr);
    return 0;
}

