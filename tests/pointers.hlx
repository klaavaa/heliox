extern fun printf(str: u8*, ...) void;


fun swap(a: i32*, b: i32*) void 
{
    temp: i32 = *a;
    *a = *b;
    *b = temp;
}

fun main() i32
{
    x: i32 = 10;
    y: i32 = 20;

    ptr: i32* = &x;

    *ptr = 100;

    printf("x = %d\ny = %d\n*ptr = %d\n\0", x, y, *ptr);
    printf("&x == ptr => %d\n\0", &x == ptr);

    swap(&x, &y);
    printf("x = %d\ny = %d\n*ptr = %d\n\0", x, y, *ptr);
    printf("&x == ptr => %d\n\0", &x == ptr);

    return y;
}
