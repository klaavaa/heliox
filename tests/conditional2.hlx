extern fun printf(str: u8*, ...) void;

fun main() i32
{
    a: i32 = 4;
    b: i32 = 8;
    
    if (a == b)
    {
        printf("%d == %d\n\0", a, b);
    }
    if ( a != b)
    {
        printf("%d != %d\n\0", a, b);
    }
    if ( a > b)
    {
        printf("%d > %d\n\0", a, b);
    }
    if ( a >= b)
    {
        printf("%d >= %d\n\0", a, b);
    }
    if ( a < b)
    {
        printf("%d < %d\n\0", a, b);
    }
    if ( a <= b)
    {
        printf("%d <= %d\n\0", a, b);
    }

    return 0;

}
