extern fun printf(u8* str, ...) void;

fun main() i32
{
    i32 a = 4;
    i32 b = 8;
    
    if (a == b)
    {
        printf("%d == %d\n\0", a, b);
    }
    if ( a != b)
    {
        printf("%d != %d\n\0", a, b);
    }
    if ( a > b)
    {
        printf("%d > %d\n\0", a, b);
    }
    if ( a >= b)
    {
        printf("%d >= %d\n\0", a, b);
    }
    if ( a < b)
    {
        printf("%d < %d\n\0", a, b);
    }
    if ( a <= b)
    {
        printf("%d <= %d\n\0", a, b);
    }

    return 0;

}
