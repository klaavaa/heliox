extern fun printf(str:u8*, ...) void;



fun main() i32
{

    a: f32 = 3.14;
    b: f64 = 1.128 * a;
    c: f32 = 0.0;
    d: f64 = 1.0;
    e: f32 = a+b;
    f: f64 = c*d;
    g: f64 = e/(f + 0.1);
    h: f64 = a-b-c-d-e-f-g;

    if a
    {
        printf("1\n\0");
    }
    if c 
    {
        printf("2\n\0");
    }
    if a > b
    {
        printf("3\n\0");
    }
    if c < d
    {
        printf("4\n\0");
    }
    if c <= c
    {
        printf("5\n\0");
    }
    if c >= c
    {
        printf("6\n\0");
    }
    if a == c 
    {
        printf("7\n\0");
    }
    if a != c 
    {
        printf("8\n\0");
    }

    printf("%.2f\n%.2f\n%.2f\n%.2f\n%.2f\n%.2f\n%.2f\n%.2f\n\0", a, b, c, d, e, f, g, h);

    return 0;
}
