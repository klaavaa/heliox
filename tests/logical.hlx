extern fun printf(str: u8*, ...) void;

fun exec(x: i32) i32
{
    printf("%d: exec\n\0", x);
    return 1;
}

fun main() i32
{
    x: i32 = 0;
    a1: i32 = 0 && exec(x); 
    x += 1;
    a2: i32 = 1 && exec(x); 
    x += 1;
    b1: i32 = 0 || exec(x);
    x += 1;
    b2: i32 = 1 || exec(x);
    return 0;
}
